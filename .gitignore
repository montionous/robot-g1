*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv*/
env/

# Local credentials (example templates may be tracked)
.env
.env.*
!.env.example
cloud.env
*.pem
*.key
*.p12
*.pfx

# Backups and generated logs
backups/
backup_*/
*.bak
*.bak_*
*.backup
*.backup_*
*.log
nohup.out

